# Ollama Settings
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_CHAT_URL=http://localhost:11434/api/chat

# ── Text embedding model ──────────────────────────────────────────────────────
# Multilingual MoE model (~958 MB). Supports ~100 languages.
# Used for all text, audio transcripts, and image captions.
# Changing this requires deleting chroma_db/ and re-syncing.
TEXT_EMBED_MODEL=nomic-embed-text-v2-moe

# ── Agent model (chat + reasoning) ───────────────────────────────────────────
# Hardware tier        Tag                      Download     Notes
# ─────────────────────────────────────────────────────────────────────────────
# Low RAM (12 GB)      gemma4:e2b               ~7 GB        Works, fewer params
# Average laptop/PC    gemma4:e4b               ~9.6 GB      Recommended default
# MacBook Pro 32 GB    gemma4:31b-it-q4_K_M     ~20 GB       Full 31B, 4-bit quant
# Apple Silicon (MLX)  gemma4:31b-mlx-bf16      ~32 GB       Metal-optimised
# Cloud demo only*     gemma4:31b-cloud         0 GB local   *Routes to Ollama servers
#
# e2b vs e4b for the agent: both work, but e4b follows tool-use instructions
# more reliably. Use e2b if e4b doesn't fit in your available RAM.
#
# * 31b-cloud sends your data to Ollama's remote infrastructure.
#   Use it to demo the app without local hardware — NOT for private data.
#
# Any Ollama tag works here, not just Gemma — e.g. llama3.2-vision, qwen2.5vl,
# gemma3:4b. For the agent, prefer a model that supports vision + tool calling
# so it can both read images and decide when to search.
AGENT_MODEL=gemma4:e4b

# ── Image / video-frame indexing backend ─────────────────────────────────────
# How images and video keyframes are turned into something searchable.
#
# Default is `clip`: tiny, no Ollama model needed, runs on any laptop. It matches
# images/frames by VISUAL SIMILARITY only — it does NOT write captions, so there's
# no OCR, no reading text on screen, and the agent can't describe images.
#
# To get captions (search/agent can read what's IN an image, OCR slides/invoices,
# match video frames by what's shown), move up a tier. That's where the
# "read the invoice / find the slide" features come from.
#
# Three tiers — start at the default, move up only for better results:
#   clip          ~400 MB pkg   default          Visual similarity only, no captions.
#   qwen2.5vl:3b  ~3.2 GB       add descriptions  Captions + strong OCR. Recommended upgrade.
#   gemma4:e2b    ~7 GB         best quality      Top captions, heavier.
#
# For maximum quality, gemma4:e4b (~9.6 GB) is the top end.
#
# Switching between clip and any captioning backend (either direction) requires
# deleting chroma_db/ and re-syncing — they use separate indexes. Switching
# between captioning backends is safe at any time.
IMAGE_CAPTIONING_BACKEND=clip

# Backend Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000

# Whisper Settings
WHISPER_MODEL_SIZE=medium

# ── Video indexing ────────────────────────────────────────────────────────────
# Videos are indexed as keyframes (each captioned like an image by the vision
# model) plus a Whisper transcript of the audio track — so you can search a video
# by what's shown AND what's said, and jump to the matching timestamp.
# Frames are chosen by scene-change detection so static footage doesn't produce
# hundreds of near-identical captions.
#
# VIDEO_SCENE_THRESHOLD  ffmpeg scene score (0-1) above which a frame is kept.
#                        Lower = more frames (0.2), higher = only big cuts (0.6).
# VIDEO_MAX_FRAMES       Hard cap on captioned frames per video (downsampled if exceeded).
# VIDEO_MIN_FRAME_GAP    Minimum seconds between kept frames (dedups rapid cuts).
VIDEO_SCENE_THRESHOLD=0.4
VIDEO_MAX_FRAMES=40
VIDEO_MIN_FRAME_GAP=1.5

# UI Settings
FRONTEND_PORT=5173
FRONTEND_URL=http://localhost:5173

# Frontend → backend URL (used by the browser directly — no Vite proxy needed).
# Change this if your backend runs on a different host or port.
VITE_API_URL=http://localhost:8000

# Logging — INFO for normal use, DEBUG to trace every indexing/search/request step.
# Backend logs stream to the console and to backend/logs/backend.log.
LOG_LEVEL=INFO
